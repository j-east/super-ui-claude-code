{
  "name": "claude-pane",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Claude Code Super UI: rendered transcript on top, live terminal below",
  "bin": {
    "claude-pane": "bin/claude-pane"
  },
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "build:app": "npm run -s build && sh scripts/build-app.sh",
    "build": "rm -rf build && tsc -p tsconfig.build.json",
    "dist": "npm run -s build && sh scripts/build-app.sh --dist",
    "electron": "npm run -s build && electron .",
    "dist:win": "npm run -s build && electron-builder --win --x64 --publish never",
    "smoke": "npm run -s build && node scripts/smoke.mjs"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.17",
    "marked": "^18.1.3",
    "node-pty": "^1.1.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "main": "electron/main.cjs",
  "author": "j-east",
  "build": {
    "appId": "world.pathwriter.claude-super-ui",
    "productName": "Claude Code Super UI",
    "directories": {
      "output": "dist.noindex/electron",
      "buildResources": "electron/resources"
    },
    "files": [
      "build/**",
      "public/**",
      "electron/*.cjs",
      "package.json"
    ],
    "asar": false,
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "Claude-Code-Super-UI-${version}-win-${arch}.${ext}",
      "icon": "electron/resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "license": "MIT"
}
